{
  "name": "atelier-projets",
  "version": "0.1.0",
  "private": true,
  "description": "Gestionnaire de projets Agile local (rigueur OpenProject, esthétique Linear/GitHub) avec intégration Git/GitHub et IA locale.",
  "license": "UNLICENSED",
  "workspaces": [
    "design-system",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "npm run db:setup --workspace=@atelier/backend",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors auto \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@atelier/backend",
    "dev:frontend": "npm run dev --workspace=@atelier/frontend",
    "app:install": "bash scripts/macos/install-launcher.sh",
    "build": "npm run build --workspace=@atelier/backend && npm run build --workspace=@atelier/frontend",
    "build:backend": "npm run build --workspace=@atelier/backend",
    "build:frontend": "npm run build --workspace=@atelier/frontend",
    "db:migrate": "npm run db:migrate --workspace=@atelier/backend --",
    "db:seed": "npm run db:seed --workspace=@atelier/backend",
    "db:reset": "npm run db:reset --workspace=@atelier/backend",
    "db:studio": "npm run db:studio --workspace=@atelier/backend --",
    "openapi": "npm run openapi --workspace=@atelier/backend && npm run api:types --workspace=@atelier/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true,
    "prisma": true
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "^10.0.6"
  }
}
