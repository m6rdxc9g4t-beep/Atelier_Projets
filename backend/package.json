{
  "name": "@atelier/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API & logique métier d'Atelier_Projets (Node.js + Fastify + TypeScript + Prisma/SQLite).",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postdb:migrate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "typebox": "~1.3.37"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^12.11.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
