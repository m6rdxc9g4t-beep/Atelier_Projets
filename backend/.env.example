# Copier ce fichier en .env pour surcharger les valeurs par défaut (toutes facultatives).
# Les variables déjà définies dans le shell restent prioritaires sur ce fichier.

# Base SQLite locale (chemin relatif au dossier backend/)
DATABASE_URL="file:./prisma/dev.db"

# Serveur HTTP — 127.0.0.1 : accessible uniquement depuis cette machine
HOST=127.0.0.1
PORT=3000
# Hôtes acceptés en plus de 127.0.0.1 / localhost / ::1 (en-têtes Host et Origin), séparés par des virgules.
# Protège l'API des sites web visités (DNS rebinding, requêtes d'un autre site). Ex. : ALLOWED_HOSTS=mon-mac.local
# ALLOWED_HOSTS=

# Niveau de logs Fastify : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Fuseau des horodatages du journal d'avancement (défaut : fuseau du système)
# APP_TIMEZONE=Europe/Paris

# GitHub (facultatif) : jeton pour les dépôts privés et un quota d'API plus large.
# Jeton « fine-grained » en lecture seule sur les Pull Requests du dépôt suffit.
# GITHUB_TOKEN=
# GitHub Enterprise : GITHUB_API_URL=https://github.example.com/api/v3

# Analyse Git : nombre maximal de commits lus par branche (défaut 5000)
# GIT_SCAN_MAX_COMMITS=5000

# IA locale (Ollama) : URL, modèle par défaut (ex. qwen2.5-coder, gemma3), délai d'une génération (ms)
# et taille maximale cumulée des git diff transmis au modèle pour « Résumer mes commits ».
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder
# OLLAMA_TIMEOUT_MS=180000
# Fenêtre de contexte demandée au modèle (tokens) : assez grande pour les diffs, sinon Ollama les tronque
# OLLAMA_NUM_CTX=16384
# AI_MAX_DIFF_CHARS=24000

# Sauvegardes de la base : copie au démarrage puis toutes les 24 h, et bouton « Sauvegarder maintenant »
# (Paramètres). Dossier (relatif à backend/) et copies gardées de chaque sorte (auto, manuelle) ; BACKUP_KEEP=0 les désactive.
# BACKUP_DIR=prisma/backups
# BACKUP_KEEP=14

# Claude CLI : commande ou chemin absolu, et application de terminal ouverte sur macOS (Terminal, iTerm…)
# CLAUDE_CLI=claude
# CLAUDE_TERMINAL_APP=Terminal
