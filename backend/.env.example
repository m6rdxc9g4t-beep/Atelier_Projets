# Copier ce fichier en .env pour surcharger les valeurs par défaut (toutes facultatives).
# Les variables déjà définies dans le shell restent prioritaires sur ce fichier.

# Base SQLite locale (chemin relatif au dossier backend/)
DATABASE_URL="file:./prisma/dev.db"

# Serveur HTTP — 127.0.0.1 : accessible uniquement depuis cette machine
HOST=127.0.0.1
PORT=3000

# Niveau de logs Fastify : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Fuseau des horodatages du journal d'avancement (défaut : fuseau du système)
# APP_TIMEZONE=Europe/Paris

# GitHub (facultatif) : jeton pour les dépôts privés et un quota d'API plus large.
# Jeton « fine-grained » en lecture seule sur les Pull Requests du dépôt suffit.
# GITHUB_TOKEN=
# GitHub Enterprise : GITHUB_API_URL=https://github.example.com/api/v3

# Analyse Git : nombre maximal de commits lus par branche (défaut 5000)
# GIT_SCAN_MAX_COMMITS=5000
