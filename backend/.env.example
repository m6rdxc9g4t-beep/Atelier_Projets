# Copier ce fichier en .env pour surcharger les valeurs par défaut (toutes facultatives).
# Les variables déjà définies dans le shell restent prioritaires sur ce fichier.

# Base SQLite locale (chemin relatif au dossier backend/)
DATABASE_URL="file:./prisma/dev.db"

# Serveur HTTP — 127.0.0.1 : accessible uniquement depuis cette machine
HOST=127.0.0.1
PORT=3000

# Niveau de logs Fastify : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
